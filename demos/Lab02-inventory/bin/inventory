#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
command="${1:-status}"; shift || true
pidfile=.inventory.pid
running() { [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }
case "$command" in
 start)
  if [[ "${1:-}" == --build ]]; then "${PYTHON:-python3}" -m compileall -q inventory.py assistant.py model.py; shift; fi
  if running; then echo 'already running'; exit 1; fi
  echo $$ > "$pidfile"; trap 'rm -f "$pidfile"' EXIT
  "${PYTHON:-python3}" assistant.py "$@" <&0 & child=$!
  trap 'kill -TERM "$child" 2>/dev/null || true' TERM INT
  wait "$child"
  ;;
 stop) if running; then kill -TERM "$(cat "$pidfile")"; else echo 'not running'; fi ;;
 restart) "$0" stop; while running; do sleep .1; done; "$0" start --build "$@" ;;
 status) if running; then echo running; else echo 'not running'; fi ;;
 test) "${PYTHON:-python3}" -m unittest discover -s tests -v ;;
 smoke) "${PYTHON:-python3}" -c 'from inventory import Inventory; assert Inventory().read()["stock"]["marker"] == 3; print("Ordinary inventory ready")' ;;
 *) echo 'usage: bin/inventory start [--build] agent|categorize|scripted [goal] | stop | restart | status | test | smoke'; exit 2 ;;
esac
