#!/usr/bin/env python3
"""Create a disposable, git-initialized example workspace."""
import argparse
import shutil
import subprocess
from pathlib import Path
parser = argparse.ArgumentParser()
parser.add_argument('--stage', choices=['starter','exercise','solution'], default='exercise')
parser.add_argument('--dest', type=Path)
args = parser.parse_args()
source = Path(__file__).resolve().parent
root = next((p for p in source.parents if (p / '.git').exists()), source.parent)
out = (args.dest or root / 'demo-scratch' / 'Lab02-inventory').resolve()
if out.exists():
    raise SystemExit(f'{out} already exists; move or remove the disposable copy before resetting')
shutil.copytree(source, out, ignore=shutil.ignore_patterns('__pycache__','*.pyc','.env','*.pid'))
shutil.copy2(out / 'fixture.json', out / 'inventory.json')
if args.stage != 'starter':
    shutil.copy2(out / 'solution' / 'assistant.py', out / 'assistant.py')
    if args.stage == 'exercise':
        p = out / 'assistant.py'
        text = p.read_text()
        text = text.replace("        messages.append({'role': 'user', 'content': 'Action observation: ' + json.dumps(observation)})", '        # TODO: deliver execution feedback to the next model request.')
        p.write_text(text)
for name in ('aider.conf.yml', 'gitignore'):
    shutil.move(out / name, out / ('.' + name))
subprocess.run(['git','init','-q',str(out)],check=True)
subprocess.run(['git','-C',str(out),'add','.'],check=True)
subprocess.run(['git','-C',str(out),'-c','user.name=Lab example','-c','user.email=example@example.invalid','commit','-qm',f'Supplied {args.stage} example, not student development history'],check=True)
subprocess.run([str(out / 'bin/inventory'), 'smoke'],check=True)
print(out)
